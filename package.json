{
  "name": "lista-compras-inteligente",
  "version": "1.0.0",
  "private": true,
  "description": "Lista de compras por seções, com status, totais em tempo real e persistência local.",
  "license": "MIT",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --host lan",
    "android": "expo start --host lan --android",
    "ios": "expo start --host lan --ios",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix --max-warnings=0 && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "58.0.23",
    "expo-haptics": "58.0.7",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
